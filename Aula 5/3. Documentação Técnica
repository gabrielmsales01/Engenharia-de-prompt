# Saída esperada: 8.333...

# Exemplo 2: Tratamento de erros automáticos (ignorando textos e notas > 10)
turma_b = [10, "faltei", 5, 12, -2]
print(calcular_media(turma_b)) 
# Saída esperada: 7.5 (calculou apenas a média entre 10 e 5)

# Exemplo 3: Lista vazia ou sem notas válidas
turma_c = ["ausente", "ausente"]
print(calcular_media(turma_c)) 
# Saída esperada: 0.0

