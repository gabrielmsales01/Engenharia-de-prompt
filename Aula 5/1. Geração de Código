Prompt Refinado:

def calcular_soma(lista_numeros):
    """
    Função que recebe uma lista de inteiros, valida seu conteúdo 
    e retorna a soma total dos elementos.
    """
    
    # 1. VALIDAÇÃO DE LISTA VAZIA
    # Em Python, listas vazias são avaliadas como 'False' em uma condição 'if'.
    # O 'len(lista_numeros) == 0' também funcionaria aqui.
    if not lista_numeros:
        return "Aviso: A lista está vazia. Não é possível calcular a soma."
    
    # 2. VALIDAÇÃO DE TIPO DE DADO (Garantindo que são apenas inteiros)
    # Percorremos a lista antes de somar para evitar erros no meio do cálculo.
    for item in lista_numeros:
        if type(item) is not int:
            return f"Erro: A lista contém um valor inválido ('{item}'). Forneça apenas inteiros."
            
    # 3. PREPARAÇÃO PARA O CÁLCULO
    # Criamos uma variável começando em zero para acumular os valores.
    soma_total = 0
    
    # 4. ITERAÇÃO (Percorrendo a lista)
    # O loop 'for' pega um número por vez da nossa lista.
    for numero in lista_numeros:
        # 5. ACÚMULO
        # Somamos o número atual ao valor que já temos guardado na 'soma_total'.
        # 'soma_total += numero' é o mesmo que 'soma_total = soma_total + numero'.
        soma_total += numero
        
    # 6. RESULTADO
    # Após o loop terminar, devolvemos o valor final calculado.
    return soma_total


