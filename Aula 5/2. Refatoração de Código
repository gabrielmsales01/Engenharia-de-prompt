// Função reutilizável para calcular o subtotal dos itens
const calcularSubtotal = (produtos) => {
    return produtos.reduce((acumulador, produto) => acumulador + produto.preco, 0);
};

// Função reutilizável para aplicar descontos percentuais
const aplicarDesconto = (valor, percentualDesconto) => {
    if (percentualDesconto <= 0) return valor;
    const multiplicador = 1 - (percentualDesconto / 100);
    return valor * multiplicador;
};

// Função principal que orquestra o cálculo
const calcularTotalPedido = (produtos, percentualDesconto = 0) => {
    if (!produtos || produtos.length === 0) return 0;
    
    const subtotal = calcularSubtotal(produtos);
    return aplicarDesconto(subtotal, percentualDesconto);
};

// Exemplo de uso:
