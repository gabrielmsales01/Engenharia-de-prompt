Prompt inicial:

function calcularTotal(array, desconto) {
    let total = array.reduce((acc, item) => acc + item.p, 0);
    
    if (desconto > 0) {
        total -= total * (desconto / 100);
    }
    return total;
}

let itens = [{p: 50}, {p: 50}];
console.log(calcularTotal(itens, 10));

Refinamento:

// Função reutilizável para calcular o subtotal dos itens
const calcularSubtotal = (produtos) => {
    return produtos.reduce((acumulador, produto) => acumulador + produto.preco, 0);
};

// Função reutilizável para aplicar descontos percentuais
const aplicarDesconto = (valor, percentualDesconto) => {
    if (percentualDesconto <= 0) return valor;
    const multiplicador = 1 - (percentualDesconto / 100);
    return valor * multiplicador;
};

// Função principal que orquestra o cálculo
const calcularTotalPedido = (produtos, percentualDesconto = 0) => {
    if (!produtos || produtos.length === 0) return 0;
    
    const subtotal = calcularSubtotal(produtos);
    return aplicarDesconto(subtotal, percentualDesconto);
};

// Exemplo de uso:
const carrinhoDeCompras = [{ preco: 50 }, { preco: 50 }];
const descontoPromocional = 10;

console.log(calcularTotalPedido(carrinhoDeCompras, descontoPromocional));

Avaliação da Diferença (Conclusão)
A diferença na qualidade da resposta é gritante e ilustra perfeitamente a importância da Engenharia de Prompts:

Profundidade da Solução: O prompt vago resultou em uma "maquiagem" no código (apenas trocou o for por reduce). O prompt refinado resultou em uma verdadeira refatoração arquitetural, transformando um script simples em um código de nível de produção.

Atendimento de Requisitos Extras: Ao pedir explicitamente por "funções reutilizáveis", a IA foi forçada a separar a lógica de soma da lógica de desconto, o que não aconteceu no primeiro caso.

